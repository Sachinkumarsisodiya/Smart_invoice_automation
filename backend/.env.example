# Application Configuration
APP_NAME=SmartInvoice
APP_ENV=development
DEBUG=true
API_V1_STR=/api
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback for quick local testing)
DATABASE_URL=sqlite:///./smartinvoice.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartinvoice

# Storage Configuration
UPLOAD_DIR=./storage/invoices
MAX_UPLOAD_SIZE_MB=15

# AI Configuration (mock | real)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Celery & Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email (SMTP) Configuration
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=notifications@smartinvoice.local
EMAILS_FROM_NAME=SmartInvoice

# Frontend
FRONTEND_URL=http://localhost:5173
