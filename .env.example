# ==============================================================================
# SMARTINVOICE - Environment Configuration Template
# ==============================================================================

# Application Environment
APP_NAME=SmartInvoice
APP_ENV=production
DEBUG=False
API_V1_STR=/api

# Security & Authentication
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=smartinvoice
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/smartinvoice

# In-Memory Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Celery Background Worker & Scheduler
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False
CELERY_TIMEZONE=UTC

# AI Extraction Engine ('mock' or 'gemini')
AI_PROVIDER=mock
GEMINI_API_KEY=

# Email Sending Configuration ('mock' or 'smtp')
EMAIL_PROVIDER=mock
EMAILS_FROM_EMAIL=notifications@smartinvoice.dev
EMAILS_FROM_NAME="SmartInvoice Billing"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=True

# Email Ingestion Configuration (IMAP / Gmail for auto-fetching invoices)
IMAP_ENABLED=True
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=sachinsisodiyaofc@gmail.com
# Set your 16-character Google App Password below (from Google Account -> Security -> 2-Step -> App Passwords)
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_USE_SSL=True
IMAP_SEARCH_CRITERIA=UNSEEN

# File Storage & Limits
UPLOAD_DIR=./storage/invoices
MAX_UPLOAD_SIZE_BYTES=20971520

# CORS Allowed Origins (JSON array string)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://localhost"]
